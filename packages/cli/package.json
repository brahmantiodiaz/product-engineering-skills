{
  "name": "@gyrospec/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "prepare": "npm --prefix ../format ci && npm --prefix ../format run build",
    "pretest": "npm --prefix ../format run build",
    "test": "vitest run",
    "pretypecheck": "npm --prefix ../format run build",
    "typecheck": "tsc --noEmit",
    "prebundle": "npm --prefix ../format run build",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": { "@gyrospec/format": "file:../format" },
  "devDependencies": { "typescript": "^7.0.2", "vitest": "^5.0.5", "@types/node": "^26.6.5", "esbuild": "^0.28.0" }
}
